-- ScrollingFrame pronto
function Lib.makeScrollFrame(parent, x, y, w, h)
    local sf = Instance.new("ScrollingFrame")
    sf.Size                = UDim2.new(0, w, 0, h)
    sf.Position            = UDim2.new(0, x, 0, y)
    sf.BackgroundTransparency = 1
    sf.ScrollBarThickness  = 4
    sf.ScrollBarImageColor3= Color3.fromRGB(80, 80, 80)
    sf.BorderSizePixel     = 0
    sf.ZIndex              = 4
    sf.Parent              = parent

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding   = UDim.new(0, 4)
    layout.Parent    = sf

    -- Auto canvas height
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        sf.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
    end)

    return sf, layout
end

