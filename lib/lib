-- ==================== HTTP HELPERS ====================

-- GET simples, retorna tabela decodificada ou nil
function Lib.apiGet(endpoint)
    local ok, res = pcall(function()
        return game:HttpGet(Lib.Config.API_BASE .. endpoint)
    end)
    if not ok or not res or res == "" then return nil end
    local ok2, data = pcall(function()
        return HttpService:JSONDecode(res)
    end)
    return ok2 and data or nil
end

-- POST JSON, retorna tabela decodificada ou nil
function Lib.apiPost(endpoint, body)
    local ok, res = pcall(function()
        return HttpService:PostAsync(
            Lib.Config.API_BASE .. endpoint,
            HttpService:JSONEncode(body or {}),
            Enum.HttpContentType.ApplicationJson
        )
    end)
    if not ok or not res or res == "" then return nil end
    local ok2, data = pcall(function()
        return HttpService:JSONDecode(res)
    end)
    return ok2 and data or nil
end

-- Busca e compila um script do GitHub.
-- Tenta o caminho original e também sem ".lua", pois vários módulos More não possuem extensão.
function Lib.fetchScript(path)
    local rawPath = tostring(path)

    local urls = {
        Lib.Config.GITHUB_RAW .. "/" .. rawPath,
    }

    local seen = {}
    for _, url in ipairs(urls) do
        if not seen[url] then
            seen[url] = true

            local ok, src = pcall(function()
                return game:HttpGet(url)
            end)

            if ok and type(src) == "string" and src ~= "" then
                local fn, err = loadstring(src)
                if fn then
                    return fn
                end

                warn("[288/lib] Erro de compilação em " .. tostring(path) .. ": " .. tostring(err))
                return nil
            end
        end
    end

    warn("[288/lib] Falha ao buscar: " .. tostring(path))
    return nil
end

-- Executa o chunk diretamente. Funciona com scripts standalone/MoonSec.
function Lib.loadModule(path, ...)
    local fn = Lib.fetchScript(path)
    if not fn then
        return false
    end

    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[288/lib] Erro ao executar " .. tostring(path) .. ": " .. tostring(err))
        return false
    end

    return true
end

-- ==================== UI HELPERS ====================

-- Cria UICorner
local function corner(inst, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 5)
    c.Parent = inst
    return c
end
Lib.corner = corner

-- Cria UIStroke
local function stroke(inst, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Lib.Colors.stroke
    s.Thickness = thickness or 1
    s.Parent = inst
    return s
end
Lib.stroke = stroke

-- Label genérico
function Lib.makeLabel(parent, props)
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Font      = props.font  or Enum.Font.Gotham
    lbl.TextSize  = props.size  or 12
    lbl.TextColor3= props.color or Lib.Colors.text
    lbl.Text      = props.text  or ""
    lbl.TextXAlignment = props.alignX or Enum.TextXAlignment.Left
    lbl.TextWrapped    = props.wrap   or false
    lbl.Size      = props.sz    or UDim2.new(1, 0, 0, 20)
    lbl.Position  = props.pos   or UDim2.new(0, 0, 0, 0)
    lbl.ZIndex    = props.z     or 4
    lbl.Parent    = parent
    return lbl
end

-- Botão padrão
function Lib.makeButton(parent, text, x, y, w, h, vipOnly)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(0, w or 120, 0, h or 32)
    btn.Position         = UDim2.new(0, x, 0, y)
    btn.BackgroundColor3 = Lib.Colors.btn
    btn.BorderSizePixel  = 0
    btn.Text             = text
    btn.TextColor3       = Lib.Colors.text
    btn.TextSize         = 12
    btn.Font             = Enum.Font.Gotham
    btn.ZIndex           = 4
    btn.Parent           = parent
    corner(btn)

    -- Hover effect
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Lib.Colors.btnHover
    end)
    btn.MouseLeave:Connect(function()
        if not btn:GetAttribute("Active") then
            btn.BackgroundColor3 = Lib.Colors.btn
        end
    end)

    -- Indicador VIP
    if vipOnly then
        local star = Instance.new("TextLabel")
        star.Size               = UDim2.new(0, 14, 0, 14)
        star.Position           = UDim2.new(1, -2, 0, -2)
        star.BackgroundTransparency = 1
        star.Text               = "✦"
        star.TextColor3         = Lib.Colors.vipStar
        star.TextSize           = 11
        star.Font               = Enum.Font.GothamBold
        star.ZIndex             = 5
        star.Parent             = btn
    end

    return btn
end

-- Toggle button (mantém estado visual ON/OFF)
function Lib.makeToggleButton(parent, text, x, y, w, h, vipOnly)
    local btn = Lib.makeButton(parent, text, x, y, w, h, vipOnly)
    btn:SetAttribute("Active", false)

    btn.MouseButton1Click:Connect(function()
        local active = not btn:GetAttribute("Active")
        btn:SetAttribute("Active", active)
        btn.BackgroundColor3 = active and Lib.Colors.btnActive or Lib.Colors.btn
    end)

    -- Retorna também setter para controle externo
    local function setState(val)
        btn:SetAttribute("Active", val)
        btn.BackgroundColor3 = val and Lib.Colors.btnActive or Lib.Colors.btn
    end

    return btn, setState
end

-- TextBox input
function Lib.makeInput(parent, placeholder, x, y, w, h)
