-- Cria um sistema de toast notifications no canto inferior direito

local notifGui = nil

local function ensureNotifGui()
    if notifGui and notifGui.Parent then return end
    notifGui = Instance.new("ScreenGui")
    notifGui.Name = "288Notifs"
    notifGui.ResetOnSpawn = false
    notifGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    notifGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local holder = Instance.new("Frame")
    holder.Name = "Holder"
    holder.Size = UDim2.new(0, 260, 1, 0)
    holder.Position = UDim2.new(1, -270, 0, 0)
    holder.BackgroundTransparency = 1
    holder.Parent = notifGui

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    layout.Padding = UDim.new(0, 6)
    layout.Parent = holder
end

--[[
    Lib.notify(title, message, type, duration)
    type: "info" | "success" | "warn" | "error"
    duration: segundos (default 4)
]]
function Lib.notify(title, message, ntype, duration)
    pcall(ensureNotifGui)
    duration = duration or 4
    ntype    = ntype or "info"

    local accentColor = ({
        info    = Lib.Colors.accent,
        success = Lib.Colors.green,
        warn    = Lib.Colors.yellow,
        error   = Lib.Colors.red,
    })[ntype] or Lib.Colors.accent

    local holder = notifGui and notifGui:FindFirstChild("Holder")
    if not holder then return end

    -- Frame do toast
    local card = Instance.new("Frame")
    card.Size             = UDim2.new(1, 0, 0, 58)
    card.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    card.BorderSizePixel  = 0
    card.BackgroundTransparency = 0.08
    card.ZIndex           = 10
    card.Parent           = holder
    corner(card, 6)
    stroke(card, accentColor, 1)

    -- Barra lateral colorida
    local bar = Instance.new("Frame")
    bar.Size             = UDim2.new(0, 3, 1, -8)
    bar.Position         = UDim2.new(0, 4, 0, 4)
    bar.BackgroundColor3 = accentColor
    bar.BorderSizePixel  = 0
    bar.ZIndex           = 11
    bar.Parent           = card
    corner(bar, 2)

    -- Título
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size             = UDim2.new(1, -18, 0, 20)
    titleLbl.Position         = UDim2.new(0, 14, 0, 6)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text             = title or "288 Panel"
    titleLbl.TextColor3       = Color3.new(1,1,1)
    titleLbl.TextSize         = 13
    titleLbl.Font             = Enum.Font.GothamBold
    titleLbl.TextXAlignment   = Enum.TextXAlignment.Left
    titleLbl.ZIndex           = 11
    titleLbl.Parent           = card

    -- Mensagem
    local msgLbl = Instance.new("TextLabel")
    msgLbl.Size             = UDim2.new(1, -18, 0, 28)
    msgLbl.Position         = UDim2.new(0, 14, 0, 26)
    msgLbl.BackgroundTransparency = 1
    msgLbl.Text             = message or ""
    msgLbl.TextColor3       = Lib.Colors.textDim
    msgLbl.TextSize         = 11
    msgLbl.Font             = Enum.Font.Gotham
    msgLbl.TextXAlignment   = Enum.TextXAlignment.Left
    msgLbl.TextWrapped      = true
    msgLbl.ZIndex           = 11
    msgLbl.Parent           = card

    -- Slide in
    card.Position = UDim2.new(1, 10, 0, 0) -- começa fora da tela
    TweenService:Create(card, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()

    -- Auto remove
    task.delay(duration, function()
        if not card.Parent then return end
        local tw = TweenService:Create(card, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 10, 0, 0),
            BackgroundTransparency = 1,
        })
        tw:Play()
        tw.Completed:Connect(function()
            card:Destroy()
        end)
    end)
end

-- ==================== CHARACTER HELPERS ====================

function Lib.getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

function Lib.getRootPart()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

function Lib.setWalkSpeed(val)
    local hum = Lib.getHumanoid()
    if hum then hum.WalkSpeed = val end
end

function Lib.setJumpPower(val)
    local hum = Lib.getHumanoid()
    if hum then hum.JumpPower = val end
end

function Lib.respawn()
    local char = LocalPlayer.Character
    if char then char:BreakJoints() end
end

function Lib.teleport(position)
    local root = Lib.getRootPart()
    if root then root.CFrame = CFrame.new(position) end
end

-- ==================== PLAYERS HELPERS ====================

-- Retorna Player pelo nome parcial (case insensitive)
function Lib.findPlayer(query)
    query = query:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(query, 1, true)
        or p.DisplayName:lower():find(query, 1, true) then
            return p
        end
    end
    return nil
end

-- Retorna o Character de um Player com segurança
function Lib.getCharacter(player)
    return player and player.Character
end

-- Retorna HumanoidRootPart de um Player
function Lib.getRoot(player)
    local char = Lib.getCharacter(player)
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- ==================== TWEEN HELPER ====================

function Lib.tween(instance, props, duration, style, direction)
    local ti = TweenInfo.new(
        duration  or 0.2,
        style     or Enum.EasingStyle.Quad,
        direction or Enum.EasingDirection.Out
    )
    local tw = TweenService:Create(instance, ti, props)
    tw:Play()
    return tw
end

-- ==================== KEYBIND HELPER ====================
-- Registra uma tecla; retorna função para desregistrar
function Lib.onKey(keyCode, callback)
    local conn = UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == keyCode then
            callback()
        end
    end)
    return function() conn:Disconnect() end
end

-- ==================== LOOP HELPER ====================
-- Roda callback em loop com intervalo; retorna função para parar
function Lib.startLoop(interval, callback)
    local running = true
    task.spawn(function()
        while running do
            task.wait(interval)
            if running then
                local ok, err = pcall(callback)
                if not ok then
                    warn("[288/lib] Erro em loop: " .. tostring(err))
                end
            end
        end
    end)
    return function() running = false end
end

-- ==================== PING HELPER ====================
function Lib.getPing()
    return math.floor(LocalPlayer:GetPing() or 0)
end

-- ==================== DATE HELPER ====================
function Lib.getDateStr()
    local t = os.date("*t")
    return string.format("%02d/%02d/%04d - %02d:%02d", t.day, t.month, t.year, t.hour, t.min)
end

