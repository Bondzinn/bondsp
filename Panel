local themeTargets = {}

local function registerTheme(obj, prop, darkKey, lightKey)
    table.insert(themeTargets, { obj=obj, prop=prop, dk=darkKey, lk=lightKey or darkKey })
end

local function applyTheme(name)
    if not THEMES[name] then return false end
    local previousTheme = THEMES[currentTheme] or THEMES.dark
    local T = THEMES[name]
    local previousAccent = ACCENT

    -- Atualiza cores diretas que nao foram registradas individualmente:
    -- fundos, textos, imagens, scrollbars, bordas e todos os SVGs vetoriais.
    if themeRoot then
        local colorProps = { "BackgroundColor3", "TextColor3", "ImageColor3", "BorderColor3", "ScrollBarImageColor3", "Color" }
        for _, obj in ipairs(themeRoot:GetDescendants()) do
            if not obj:GetAttribute("PreserveThemeColor") then
                for _, prop in ipairs(colorProps) do
                    pcall(function()
                        local oldColor = obj[prop]
                        if typeof(oldColor) ~= "Color3" then return end
                        if oldColor == previousAccent then
                            obj[prop] = T.accent
                            return
                        end
                        for key, oldPaletteColor in pairs(previousTheme) do
                            if typeof(oldPaletteColor) == "Color3" and oldColor == oldPaletteColor and typeof(T[key]) == "Color3" then
                                obj[prop] = T[key]
                                return
                            end
                        end
                    end)
                end
                if obj:IsA("UIGradient") and obj.Name == "PanelThemeGradient" then
                    obj.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, T.header),
                        ColorSequenceKeypoint.new(0.55, T.content),
                        ColorSequenceKeypoint.new(1, T.main),
                    })
                end
            end
        end
    end

    currentTheme = name
    ACCENT = T.accent or ACCENT
    for i = #themeTargets, 1, -1 do
        local e = themeTargets[i]
        if not e.obj or e.obj.Parent == nil then
            table.remove(themeTargets, i)
        else
            local key = e.dk
            if T[key] ~= nil then
                pcall(function() e.obj[e.prop] = T[key] end)
            end
        end
    end
    return true
end

-- ==================== VECTOR ICONS ====================
-- Roblox não renderiza SVG inline. Estes ícones são desenhados com Frames/UIStroke,
-- mantendo aparência vetorial sem depender de emoji ou fonte externa.
local toggleStates = {}

local function vectorLine(parent, x, y, w, h, color, rotation, radius)
    local line = Instance.new("Frame")
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.Position = UDim2.new(0, x, 0, y)
    line.Size = UDim2.new(0, w, 0, h)
    line.BackgroundColor3 = color or ACCENT
    line.BorderSizePixel = 0
    line.Rotation = rotation or 0
    line.ZIndex = (parent.ZIndex or 1) + 1
    line.Parent = parent
    if radius then
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(1, 0)
        c.Parent = line
    end
    return line
end

local function vectorOutline(parent, x, y, w, h, color, radius)
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position = UDim2.new(0, x, 0, y)
    f.Size = UDim2.new(0, w, 0, h)
    f.BackgroundTransparency = 1
    f.BorderSizePixel = 0
    f.ZIndex = (parent.ZIndex or 1) + 1
    f.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 3)
    corner.Parent = f

    local stroke = Instance.new("UIStroke")
    stroke.Color = color or ACCENT
    stroke.Thickness = 1.5
    stroke.Parent = f
    return f
end

local function makeVectorIcon(parent, kind, x, y, size, color)
    size = size or 18
    color = color or ACCENT

    local holder = Instance.new("Frame")
    holder.Name = "VectorIcon_" .. tostring(kind)
    holder.Size = UDim2.new(0, size, 0, size)
    holder.Position = UDim2.new(0, x or 0, 0, y or 0)
    holder.BackgroundTransparency = 1
    holder.BorderSizePixel = 0
    holder.ZIndex = (parent.ZIndex or 1) + 2
    holder.Parent = parent

    local c = size / 2

    if kind == "desktop" then
        vectorOutline(holder, c, c - 2, size * 0.78, size * 0.52, color, 2)
        vectorLine(holder, c, size * 0.76, 2, size * 0.20, color, 0, true)
        vectorLine(holder, c, size * 0.88, size * 0.38, 2, color, 0, true)

    elseif kind == "mobile" then
        vectorOutline(holder, c, c, size * 0.48, size * 0.82, color, 3)
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 2.5, 0, 2.5)
        dot.Position = UDim2.new(0.5, -1.25, 0.78, -1.25)
        dot.BackgroundColor3 = color
        dot.BorderSizePixel = 0
        dot.ZIndex = holder.ZIndex + 2
        dot.Parent = holder
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    elseif kind == "console" then
        vectorOutline(holder, c, c + 1, size * 0.82, size * 0.48, color, 5)
        vectorLine(holder, size * 0.32, c + 1, size * 0.22, 2, color, 0, true)
        vectorLine(holder, size * 0.32, c + 1, 2, size * 0.22, color, 0, true)
        for _, px in ipairs({0.66, 0.77}) do
            local d = Instance.new("Frame")
            d.Size = UDim2.new(0, 3, 0, 3)
            d.Position = UDim2.new(px, -1.5, 0.5, -0.5)
            d.BackgroundColor3 = color
            d.BorderSizePixel = 0
            d.ZIndex = holder.ZIndex + 2
            d.Parent = holder
            Instance.new("UICorner", d).CornerRadius = UDim.new(1, 0)
