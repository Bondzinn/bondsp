local function createBillboard(character, rank, device, remoteVisible)
    if not character then return end
    if _shuttingDown then return end
    if not _tagsVisible then return end
    if remoteVisible == false then return end

    local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 5)
    if not head or not head:IsA("BasePart") then return end

    local old = character:FindFirstChild("288TagGui", true)
    if old then old:Destroy() end
    local oldSupport = character:FindFirstChild("288TagSupport")
    if oldSupport then oldSupport:Destroy() end

    rank = rank or "User"
    local color = ROLE_COLORS_MAP[rank] or ROLE_COLORS_MAP.User
    local deviceKind = platformKind(device)

    local bb = Instance.new("BillboardGui")
    bb.Name = "288TagGui"
    bb.Size = UDim2.new(0, 220, 0, 30)
    bb.AutoLocalize = false

    -- Mantém a tag próxima da cabeça.
    -- A elevação extra com o zoom é propositalmente pequena.
    local support = Instance.new("Part")
    support.Name = "288TagSupport"
    support.Size = Vector3.new(0.1, 0.1, 0.1)
    support.Transparency = 1
    support.CanCollide = false
    support.CanTouch = false
    support.CanQuery = false
    support.Massless = true
    support.Anchored = false
    local tagHeight = (head.Size.Y * 0.5 + 0.72) * 2
    support.CFrame = head.CFrame * CFrame.new(0, tagHeight, 0)
    support.Parent = character

    local weld = Instance.new("WeldConstraint")
    weld.Name = "288TagHeadWeld"
    weld.Part0 = head
    weld.Part1 = support
    weld.Parent = support

    local MAX_EXTRA_Y = 0.32
    bb.Adornee = support
    bb.StudsOffsetWorldSpace = Vector3.new(0, 0, 0)

    bb.AlwaysOnTop = true
    bb.ResetOnSpawn = false
    bb.MaxDistance = TAG_MAX_DISTANCE
    bb.LightInfluence = 0
    bb.Parent = support

    -- Container central para rank + ícone.
    -- AutomaticSize evita que nomes de ranks maiores puxem o conjunto para um lado.
    local row = Instance.new("Frame")
    row.Name = "CenteredTagContent"
    row.AnchorPoint = Vector2.new(0.5, 0.5)
    row.Position = UDim2.new(0.5, 0, 0.5, 0)
    row.Size = UDim2.new(0, 0, 0, 26)
