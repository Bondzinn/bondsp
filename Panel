    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 5)
    layout.Parent = row

    local lbl = Instance.new("TextLabel")
    lbl.Name = "TagText"
    lbl.LayoutOrder = 1
    lbl.Size = UDim2.new(0, 0, 0, 26)
    lbl.AutomaticSize = Enum.AutomaticSize.X
    lbl.BackgroundTransparency = 1
    lbl.BorderSizePixel = 0
    lbl.Text = rank
    lbl.TextColor3 = color
    lbl.TextTransparency = 0
    lbl.AutoLocalize = false

    -- Bold + contorno de contraste para legibilidade em qualquer cenário.
    local luminance = color.R * 0.299 + color.G * 0.587 + color.B * 0.114
    lbl.TextStrokeColor3 = luminance < 0.5
        and Color3.fromRGB(255, 255, 255)
        or Color3.fromRGB(0, 0, 0)
    lbl.TextStrokeTransparency = 0
    lbl.TextSize = 14
    lbl.FontFace = TAG_FONT_FACE
