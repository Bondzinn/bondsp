    iconSlot.LayoutOrder = 2
    iconSlot.Size = UDim2.new(0, 16, 0, 16)
    iconSlot.BackgroundTransparency = 1
    iconSlot.BorderSizePixel = 0
    iconSlot.Parent = row

    local PLATFORM_ICON_COLOR = Color3.fromRGB(0, 0, 0)
    local iconHolder = makeVectorIcon(iconSlot, deviceKind, 0, 0, 16, PLATFORM_ICON_COLOR)
    iconHolder.Name = "PlatformIcon"

    -- Compensação leve conforme a câmera se afasta.
    -- A tag sobe no máximo 0.32 stud, então nunca "descola" muito da cabeça.
    task.spawn(function()
        while bb.Parent and support.Parent and head.Parent do
            local camera = workspace.CurrentCamera
            if camera then
                local distance = (camera.CFrame.Position - head.Position).Magnitude
                local alpha = math.clamp((distance - 8) / 22, 0, 1)
                local extraY = MAX_EXTRA_Y * alpha
                bb.StudsOffsetWorldSpace = Vector3.new(0, extraY, 0)
            end
            RunService.RenderStepped:Wait()
        end
    end)

    if MIRROR_SHINE_RANKS[rank] then
        -- Mantem a tag base igual as demais e desenha somente o reflexo por cima.
        local reflectionText = Instance.new("TextLabel")
        reflectionText.Name = "MirrorReflection"
        reflectionText.Size = UDim2.fromScale(1, 1)
        reflectionText.Position = UDim2.fromScale(0, 0)
