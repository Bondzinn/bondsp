-- ==================== EMPHASIS TAB ====================
do
    local f = Tabs["Emphasis"].frame
    local y = 10
    local controls = {}
    local keyStatus = {
        Flashback = false,
        AnimeSlow = false,
        AnimeFast = false,
    }
    local emphasisBtns = {
        {name="Invisible", order=1, hint="Mouse: para Ativar/Desativar"},
        {name="ClickTP", order=2, hint="Ctrl + Clique: para teleportar"},
        {name="NoClip", order=3, hint="N: para Ativar/Desativar"},
        {name="Emote", order=4, hint="Mouse: para Ativar/Desativar"},
        {name="Impulse", order=5, hint="M: para Ativar"},
        {name="Face Target", order=6, hint="Mouse: para Ativar/Desativar"},
        {name="Spin", order=7, hint="Mouse: para Ativar/Desativar"},
        {name="AnimSpeed", order=8, hint="Q: Lento | E: Rapido"},
        {name="feFlip", order=9, hint="X: Frontflip | C: Backflip"},
        {name="Flashback", order=10, hint="Segure V para voltar; solte para parar"},
        {name="AntiVoid", order=11, hint="Mouse: para Ativar/Desativar"},
    }

    local function setControlState(control, active)
        toggleStates[control.btn] = active
        control.btn.BackgroundColor3 = active
            and THEMES[currentTheme].btnOn
            or THEMES[currentTheme].btn
    end

    for _, v in ipairs(emphasisBtns) do
        local col = (v.order % 2 == 1) and COL1 or COL2
        local row = math.floor((v.order - 1) / 2)
        local yPos = y + row * (BTN_H + GAP)
        local btn = makeToggleButton(f, v.name, col, yPos, BTN_W, BTN_H)
        btn.TextSize = 13
        btn:SetAttribute("288SilentNotification", true)

        local dotX = (v.order % 2 == 1) and DOT1_X or DOT2_X
        makeMouseDot(f, dotX, yPos + BTN_H/2 - DOT_SIZE/2, DOT_SIZE)

        local moduleName = tostring(v.name):gsub("%s+", "")
        if moduleName == "AnimSpeed" then moduleName = "AnimeSpeed" end
        local control = {btn=btn, moduleName=moduleName, initialized=false, hint=v.hint, activationNotified=false}
        controls[moduleName] = control

        btn.MouseButton1Click:Connect(function()
            -- Aguarda o makeToggleButton concluir para sempre ler o estado final.
            task.defer(function()
                if not btn.Parent then return end
                local active = toggleStates[btn] == true
                if moduleName == "ClickTP" then
                    GLOBAL.__288ClickTPDesiredState = active
                end
                local loaded = loadModule("modules/Emphasis/" .. moduleName)
                if not loaded then return end

                control.initialized = true
                local title = moduleName == "AnimeSpeed" and "AnimeSpeed" or v.name
                if moduleName == "Flashback" then
                    if active and not control.activationNotified then
                        control.activationNotified = true
                        notifyPanel(title, v.hint, "success")
                    end
                elseif active then
                    notifyPanel(title, v.hint, "success")
                else
                    notifyPanel(title, "Status: Desativado", "warning")
                    if moduleName == "AnimeSpeed" then
                        keyStatus.AnimeSlow = false
                        keyStatus.AnimeFast = false
                    end
                end
            end)
        end)

        registerCleanup("Emphasis/" .. v.name, function()
            if toggleStates[btn] then
                if moduleName == "ClickTP" then
                    GLOBAL.__288ClickTPDesiredState = false
                end
                loadModule("modules/Emphasis/" .. moduleName)
            end
        end)
    end

    trackConnect(UserInputService.InputBegan, function(input, gpe)
        if gpe then return end

        if input.KeyCode == Enum.KeyCode.N then
            local control = controls.NoClip
            if not control or not control.initialized then return end
            local nextState = not (toggleStates[control.btn] == true)
            if not loadModule("modules/Emphasis/" .. control.moduleName) then return end
            setControlState(control, nextState)
            notifyPanel("NoClip", nextState and "Status: Ativado" or "Status: Desativado", nextState and "success" or "warning")

        elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.E then
            local control = controls.AnimeSpeed
            if not control or not control.initialized or toggleStates[control.btn] ~= true then return end
            if input.KeyCode == Enum.KeyCode.Q then
                keyStatus.AnimeSlow = not keyStatus.AnimeSlow
                keyStatus.AnimeFast = false
                notifyPanel("AnimeSpeed", keyStatus.AnimeSlow and "Q - Status: Ativado" or "Q - Status: Desativado", keyStatus.AnimeSlow and "success" or "warning")
            else
                keyStatus.AnimeFast = not keyStatus.AnimeFast
                keyStatus.AnimeSlow = false
                notifyPanel("AnimeSpeed", keyStatus.AnimeFast and "E - Status: Ativado" or "E - Status: Desativado", keyStatus.AnimeFast and "success" or "warning")
            end

        elseif input.KeyCode == Enum.KeyCode.X or input.KeyCode == Enum.KeyCode.C then
            local control = controls.feFlip
            if control and control.initialized and toggleStates[control.btn] == true then
                notifyPanel("feFlip", input.KeyCode == Enum.KeyCode.X and "X: Frontflip" or "C: Backflip", "success")
            end
        end
    end)


    refreshCanvas(f)
end
