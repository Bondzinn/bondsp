local activeServerProfiles = {}

local function monitorOtherPlayers()
    local monitored = {}

    local function destroyTag(character)
        if not character then return end
        local gui = character:FindFirstChild("288TagGui", true)
        if gui then gui:Destroy() end
        local support = character:FindFirstChild("288TagSupport")
        if support then support:Destroy() end
    end

    local function refreshPlayerTag(p)
        if not p or p == LocalPlayer then return end
        local char = p.Character
        if not char then return end

        if not _tagsVisible then
            destroyTag(char)
            return
        end

        -- A API é a fonte de verdade para visibilidade/rank/device entre clientes.
        local profile = activeServerProfiles[tostring(p.UserId)]
        if profile then
            local visible = profile.tagVisible ~= false
            if visible then
                createBillboard(
                    char,
                    profile.rank or "User",
                    profile.device or "desktop",
                    true
                )
            else
                destroyTag(char)
            end
            return
        end

        -- Fallback para o modelo antigo caso a API esteja indisponível.
        destroyTag(char)
    end

    local function hookPlayer(p)
        if not p or p == LocalPlayer or monitored[p] then return end
        monitored[p] = true

        trackConnect(p.CharacterAdded, function()
            task.wait(1)
            refreshPlayerTag(p)
        end)

        task.spawn(function()
            while ScreenGui.Parent and p.Parent == Players do
                refreshPlayerTag(p)
                task.wait(5)
            end
            monitored[p] = nil
        end)
    end

    for _, p in ipairs(Players:GetPlayers()) do
        hookPlayer(p)
    end
    trackConnect(Players.PlayerAdded, hookPlayer)

    task.spawn(function()
        while ScreenGui.Parent and not _shuttingDown do
            local endpoint = "/session/active?game=" .. HttpService:UrlEncode(tostring(game.PlaceId))
                .. "&server=" .. HttpService:UrlEncode(tostring(game.JobId))
            local response = apiGet(endpoint)
            if response and type(response.players) == "table" then
                local nextProfiles = {}
                for _, profile in ipairs(response.players) do
                    nextProfiles[tostring(profile.userid)] = profile
                end
                activeServerProfiles = nextProfiles
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then refreshPlayerTag(player) end
                end
            end
            task.wait(5)
        end
    end)
end

local function setAllRenderedTagsVisible(visible)
    _tagsVisible = visible == true

    if not _tagsVisible then
        for _, p in ipairs(Players:GetPlayers()) do
            local char = p.Character
            if char then
                local gui = char:FindFirstChild("288TagGui", true)
                if gui then gui:Destroy() end
                local support = char:FindFirstChild("288TagSupport")
                if support then support:Destroy() end
            end
        end
    else
        local ownChar = LocalPlayer.Character
        if ownChar then
            createBillboard(ownChar, _currentRank, DEVICE, true)
        end
    end
end

local function broadcastOwnTag(rank)
    local char = LocalPlayer.Character
    if not char then return end
    local v = char:FindFirstChild("288Tag")
    if not v then
        v = Instance.new("StringValue")
        v.Name   = "288Tag"
        v.Parent = char
    end
    v.Value = rank

    local d = char:FindFirstChild("288Device")
    if not d then
        d = Instance.new("StringValue")
        d.Name = "288Device"
        d.Parent = char
    end
    d.Value = DEVICE

    local visibleValue = char:FindFirstChild("288TagVisible")
    if not visibleValue then
        visibleValue = Instance.new("BoolValue")
        visibleValue.Name = "288TagVisible"
        visibleValue.Parent = char
    end
    visibleValue.Value = _tagsVisible
end

