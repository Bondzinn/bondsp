        reflectionText.BorderSizePixel = 0
        reflectionText.Text = rank
        reflectionText.TextColor3 = Color3.fromRGB(255, 255, 255)
        reflectionText.TextTransparency = 0
        reflectionText.TextStrokeTransparency = 1
        reflectionText.TextSize = lbl.TextSize
        reflectionText.FontFace = TAG_FONT_FACE
        reflectionText.TextXAlignment = lbl.TextXAlignment
        reflectionText.TextYAlignment = lbl.TextYAlignment
        reflectionText.AutoLocalize = false
        reflectionText.ZIndex = lbl.ZIndex + 1
        reflectionText.Parent = lbl

        local shine = Instance.new("UIGradient")
        shine.Name = "MirrorShine"
        shine.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
        shine.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.38, 1),
            NumberSequenceKeypoint.new(0.47, 0.35),
            NumberSequenceKeypoint.new(0.5, 0),
            NumberSequenceKeypoint.new(0.53, 0.35),
            NumberSequenceKeypoint.new(0.62, 1),
            NumberSequenceKeypoint.new(1, 1),
        })
        shine.Offset = Vector2.new(-1.25, 0)
        shine.Rotation = 0
        shine.Parent = reflectionText

        task.spawn(function()
            while bb.Parent and lbl.Parent and reflectionText.Parent do
                shine.Offset = Vector2.new(-1.25, 0)
                local reflection = TweenService:Create(
                    shine,
                    TweenInfo.new(2.4, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
                    {Offset = Vector2.new(1.25, 0)}
                )
                reflection:Play()
                reflection.Completed:Wait()
                task.wait(1)
            end
        end)
    end
    return bb
end

