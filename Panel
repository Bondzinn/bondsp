-- HttpGet -> loadstring -> execução do chunk. Não esperamos retorno/função de módulo.

local MORE_MODULE_URLS = {
    ESP = GITHUB_RAW .. "/modules/More/ESP",
    Aimbot = GITHUB_RAW .. "/modules/More/Aimbot",
    PianoAuto = GITHUB_RAW .. "/modules/More/PianoAuto",

    AnimSpeed = GITHUB_RAW .. "/modules/Emphasis/AnimeSpeed",
