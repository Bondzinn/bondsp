    end

    local function loadServers()
        for _, c in pairs(serverList:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        loadFriendsInOtherServers()
        
        if not http_request then
            warn("[288] Este ambiente não fornece uma função de HTTP request compatível para listar servidores.")
            return
        end

        local okRequest, response = pcall(http_request, {
            Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?limit=10",
            Method = "GET"
        })
        if not okRequest or not response then
            warn("[288] Falha ao buscar servidores: " .. tostring(response))
            return
        end

        local statusCode = response.StatusCode or response.Status or 0
        if statusCode == 200 then
            local okDecode, data = pcall(function() return HttpService:JSONDecode(response.Body or "{}") end)
            if not okDecode then
                warn("[288] Resposta inválida ao buscar servidores")
                return
            end
            if data and data.data then
                for i, s in ipairs(data.data) do
                    local serverData = {
                        id = s.id,
                        players = s.playing,
                        maxPlayers = s.maxPlayers,
                        ping = s.ping or 0
                    }
                    makeServerCard(serverData, i)
                end
                local rows = math.ceil(#data.data / 2)
                serverList.CanvasSize = UDim2.new(0, 0, 0, rows * (CARD_H + GAP_Y))
            end
        else
            warn("Falha ao buscar servidores: " .. tostring(statusCode))
        end
    end

