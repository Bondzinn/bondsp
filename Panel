        joinLabel.TextSize = 9
        joinLabel.Font = Enum.Font.Gotham
        joinLabel.TextXAlignment = Enum.TextXAlignment.Left
        joinLabel.ZIndex = 6
        joinLabel.Parent = card

        if userId then
