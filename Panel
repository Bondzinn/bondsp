    Spin = GITHUB_RAW .. "/modules/Emphasis/Spin",
    feFlip = GITHUB_RAW .. "/modules/Emphasis/feFlip",
}

local USE_LOCAL_SPECIAL_MODULES = false

local function fetchModuleSource(url)
    local separator = url:find("?", 1, true) and "&" or "?"
    local requestUrl = url .. separator .. "_=" .. tostring(os.time())

    if executorRequest then
        local okRequest, response = pcall(executorRequest, { Url = requestUrl, Method = "GET" })
        if okRequest and response then
            if type(response) == "string" and #response > 0 then
                return response
            elseif type(response) == "table" then
                local status = tonumber(response.StatusCode or response.Status or response.status_code) or 0
                local body = response.Body or response.body or response.ResponseBody
                if (status == 0 or (status >= 200 and status < 300)) and type(body) == "string" and #body > 0 then
                    return body
                end
            end
        end
    end

    local okHttp, source = pcall(function() return game:HttpGet(requestUrl) end)
    if okHttp and type(source) == "string" and #source > 0 then return source end
    local okPlain, plain = pcall(function() return game:HttpGet(url) end)
    return okPlain and type(plain) == "string" and #plain > 0 and plain or nil
end

local function executeModuleSource(source)
    if type(source) ~= "string" or source == "" then return false, "fonte vazia" end
    source = source:gsub("^\239\187\191", "")
    local trimmed = source:match("^%s*(.-)%s*$") or source
    if trimmed:sub(1, 1) == "<" or trimmed:match('^%{"error"') then
        return false, "resposta remota nao contem Lua"
    end

    local chunk, compileErr = loadstring(source)
    if not chunk then return false, "compile: " .. tostring(compileErr) end
    local okRun, runErr = pcall(chunk)
    if not okRun then return false, "runtime: " .. tostring(runErr) end
    return true
end

local function executeRemoteScript(url, label)
    local source = fetchModuleSource(url)
    if not source then
        warn("[288] fetch error [" .. tostring(label) .. "]: " .. tostring(url))
        return false
    end
    local ok, err = executeModuleSource(source)
    if not ok then warn("[288] module error [" .. tostring(label) .. "]: " .. tostring(err)) end
    return ok
end

local function normalizeModuleName(path)
    local name = tostring(path):match("([^/]+)$") or tostring(path)
    name = name:gsub("%.lua$", "")
    name = name:gsub("Off$", "")

    if name == "AnimeSpeed" then
        return "AnimeSpeed"
    end

    return name
end

local function runEmbeddedESP()
    local key = "__288EmbeddedESP"
    if GLOBAL[key] then
        GLOBAL[key].connection:Disconnect()
        GLOBAL[key].added:Disconnect()
        GLOBAL[key].removing:Disconnect()
        for _, visual in pairs(GLOBAL[key].visuals) do
            for _, drawing in pairs(visual) do pcall(function() drawing:Remove() end) end
        end
        GLOBAL[key] = nil
        return true
    end
    if not Drawing or type(Drawing.new) ~= "function" then
        warn("[288 ESP] Drawing API is unavailable in this executor.")
        return false
    end

    local state = {visuals = {}}
    local MAX_DISTANCE, INFO_DISTANCE = 500, 300
    local function line(width)
        local object = Drawing.new("Line")
        object.Visible, object.Thickness = false, width or 1
        return object
    end
    local function text(size)
        local object = Drawing.new("Text")
        object.Visible, object.Center, object.Outline = false, true, true
        object.Size, object.Font = size or 12, 2
        return object
    end
    local function add(player)
        if player == LocalPlayer or state.visuals[player] then return end
        state.visuals[player] = {
            top=line(2), bottom=line(2), left=line(2), right=line(2),
            hpBack=line(4), hp=line(2), name=text(13), info=text(12),
        }
    end
    local function remove(player)
        local visual = state.visuals[player]
        if not visual then return end
        for _, drawing in pairs(visual) do pcall(function() drawing:Remove() end) end
        state.visuals[player] = nil
    end
    local function hide(visual)
        for _, drawing in pairs(visual) do drawing.Visible = false end
    end
    local function colorFor(player)
        if LocalPlayer.Team and player.Team then
            return player.Team == LocalPlayer.Team and Color3.fromRGB(70,225,120) or Color3.fromRGB(255,70,90)
        end
        return Color3.fromRGB(255,195,70)
    end

    for _, player in ipairs(Players:GetPlayers()) do add(player) end
    state.added = Players.PlayerAdded:Connect(add)
    state.removing = Players.PlayerRemoving:Connect(remove)
    state.connection = RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        local ownRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not camera then return end
        local candidates = {}
        for player, visual in pairs(state.visuals) do
            hide(visual)
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local head = character and character:FindFirstChild("Head")
            if not humanoid or humanoid.Health <= 0 or not root or not head then continue end
            local distance = ownRoot and (ownRoot.Position-root.Position).Magnitude or math.huge
            if distance <= MAX_DISTANCE then
                table.insert(candidates, {player=player, visual=visual, humanoid=humanoid, root=root, head=head, distance=distance})
            end
        end
        table.sort(candidates, function(a, b) return a.distance < b.distance end)
        for index = 1, #candidates do
            local item = candidates[index]
            local player, visual = item.player, item.visual
            local humanoid, root, head, distance = item.humanoid, item.root, item.head, item.distance
            local center, visible = camera:WorldToViewportPoint(root.Position)
            local top = camera:WorldToViewportPoint(head.Position + Vector3.new(0, .75, 0))
            local bottom = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
            if not visible or center.Z <= 0 then hide(visual) continue end
            local height = math.max(18, math.abs(bottom.Y-top.Y))
            local width, left, right = height*.52, center.X-height*.26, center.X+height*.26
            local color, hpRatio = colorFor(player), math.clamp(humanoid.Health/math.max(humanoid.MaxHealth,1),0,1)
            visual.top.From,visual.top.To=Vector2.new(left,top.Y),Vector2.new(right,top.Y)
            visual.bottom.From,visual.bottom.To=Vector2.new(left,bottom.Y),Vector2.new(right,bottom.Y)
            visual.left.From,visual.left.To=Vector2.new(left,top.Y),Vector2.new(left,bottom.Y)
            visual.right.From,visual.right.To=Vector2.new(right,top.Y),Vector2.new(right,bottom.Y)
            for _, boxLine in ipairs({visual.top,visual.bottom,visual.left,visual.right}) do boxLine.Color,boxLine.Visible=color,true end
            visual.hpBack.From,visual.hpBack.To=Vector2.new(left-6,top.Y),Vector2.new(left-6,bottom.Y)
            visual.hpBack.Color,visual.hpBack.Visible=Color3.fromRGB(35,35,40),true
            visual.hp.From,visual.hp.To=Vector2.new(left-6,bottom.Y),Vector2.new(left-6,bottom.Y-height*hpRatio)
            visual.hp.Color,visual.hp.Visible=Color3.fromHSV(hpRatio*.33,.9,1),true
            visual.name.Text,visual.name.Position,visual.name.Color=player.DisplayName,Vector2.new(center.X,top.Y-17),color
            visual.name.Visible=true
            visual.info.Text=string.format("%d HP | %d studs",math.floor(humanoid.Health+.5),math.floor(distance+.5))
            visual.info.Position,visual.info.Color=Vector2.new(center.X,bottom.Y+3),Color3.new(1,1,1)
            visual.info.Visible=distance <= INFO_DISTANCE
        end
    end)
    GLOBAL[key] = state
    return true
end

local function loadModule(path)
    local name = normalizeModuleName(path)
    local exactUrl = MORE_MODULE_URLS[name]

    if USE_LOCAL_SPECIAL_MODULES and type(readfile) == "function" then
        local requestedPath = tostring(path):gsub("^/+", "")
        local localVariants = {requestedPath, requestedPath:gsub("%.lua$", "")}
        if not requestedPath:match("%.lua$") then table.insert(localVariants, requestedPath .. ".lua") end
        local checked = {}
        for _, localPath in ipairs(localVariants) do
            if not checked[localPath] then
                checked[localPath] = true
                local okRead, source = pcall(readfile, localPath)
                if okRead and type(source) == "string" and source ~= "" then
                    local okRun, moduleError = executeModuleSource(source)
                    if okRun then return true end
                    warn("[288] local module failed [" .. localPath .. "]: " .. tostring(moduleError))
                end
            end
        end
    end

    -- Emphasis/More use the same API /raw route as Target and Misc.
    if exactUrl then
        local apiPath = tostring(path):gsub("^/+", ""):gsub("%.lua$", "")
        return executeRemoteScript(API_BASE .. "/raw/" .. apiPath, name)
    end

    -- Os arquivos do repositório não possuem extensão: usa o caminho exatamente como recebido.
    local requestedPath = tostring(path):gsub("^/+", "")
    local extensionlessPath = requestedPath:gsub("%.lua$", "")
    local pathVariants = { requestedPath, extensionlessPath }
    if not requestedPath:match("%.lua$") then
        table.insert(pathVariants, requestedPath .. ".lua")
    end

    local candidates = {}
    for _, modulePath in ipairs(pathVariants) do
        table.insert(candidates, API_BASE .. "/raw/" .. modulePath)
        table.insert(candidates, GITHUB_RAW .. "/" .. modulePath)
    end

    local seen = {}
    for _, url in ipairs(candidates) do
        if not seen[url] then
            seen[url] = true

            local source = fetchModuleSource(url)
            if source then
                local okRun, moduleError = executeModuleSource(source)
                if okRun then return true end
                warn("[288] candidate failed [" .. tostring(url) .. "]: " .. tostring(moduleError))
            end
        end
    end

    warn("[288] module not found: " .. tostring(path))
    return false
end

local function runPanelModule(name)
    return loadModule("modules/More/" .. tostring(name))
end

