        if HomeUI.onlineValue then HomeUI.onlineValue.Text = tostring(res.stats.online or "--") end
        if HomeUI.usersValue then HomeUI.usersValue.Text = tostring(res.stats.totalUsers or "--") end
    end

    broadcastOwnTag(rank)
    local char = LocalPlayer.Character
    if char then createBillboard(char, rank) end

    if res.user and res.user.theme then
        local savedTheme = res.user.theme
        if THEMES[savedTheme] then
            applyTheme(savedTheme)
            setTab(CurrentTab)
            -- O ícone do tema é vetorial e não depende de texto/emoji.
        end
    end
    -- Atualiza a data do Home com o timestamp da sessão (servidor)
    if HomeUI and HomeUI.dateLabel and res.timestamp then
        local ok, ts = pcall(function() return tonumber(res.timestamp) end)
        if ok and ts then
            local t = os.date("*t", math.floor(ts/1000))
            HomeUI.dateLabel.Text = string.format(HomeUI.sessionTitle .. "  " .. HomeUI.sessionSeparator .. "  %02d/%02d/%04d  %02d:%02d",
                t.day, t.month, t.year, t.hour, t.min)
        end
    end
    setLoadingProgress(96, "Carregando background...")
    local backgroundDeadline = os.clock() + 4
    while BgLabel.Parent and not BgLabel.IsLoaded and os.clock() < backgroundDeadline do
        task.wait(0.1)
    end

    setLoadingProgress(100, "Tudo pronto!")
    task.wait(0.18)
    finishLoading("Tudo pronto!")
end)

-- ==================== HEARTBEAT ====================
task.spawn(function()
    while task.wait(30) do
        if not ScreenGui.Parent then break end
        if not _sessionId then continue end
        local res = apiPost("/session/heartbeat", {
            sessionId = _sessionId,
            userid    = LocalPlayer.UserId,
        })
        if res then
            if res.user and res.user.rank and res.user.rank ~= _currentRank then
                _currentRank = res.user.rank
                refreshVipAccess(_currentRank, res.user.vip)
                broadcastOwnTag(_currentRank)
                local ownCharacter = LocalPlayer.Character
                if ownCharacter then createBillboard(ownCharacter, _currentRank, DEVICE, true) end
            elseif res.user then
                refreshVipAccess(res.user.rank or _currentRank, res.user.vip)
            end
            if HomeUI.onlineValue and res.online ~= nil then
                HomeUI.onlineValue.Text = tostring(res.online)
            end
            if HomeUI.usersValue and res.totalUsers ~= nil then
                HomeUI.usersValue.Text = tostring(res.totalUsers)
            end
            if res.kick then
                cleanupPanel()
                ScreenGui:Destroy()
                break
            end
        end
    end
end)

