        clone:PivotTo(CFrame.new(0, 0, 0))

        local cf, size = clone:GetBoundingBox()
        local focusY = cf.Position.Y + size.Y * 0.05
        local radius = math.max(size.X, size.Y, size.Z)
        local distance = math.max(4.5, radius * 1.65)

        -- Roblox characters face toward -Z by default.
        -- Put the preview camera on the -Z side so the avatar is shown from the front.
        avatarCamera.CFrame = CFrame.lookAt(
            Vector3.new(0, focusY + 0.15, -distance),
            Vector3.new(0, focusY, 0)
        )

