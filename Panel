local function platformKind(device)
    if device == "mobile" then return "mobile" end
    if device == "console" then return "console" end
    return "desktop"
end

local function addHover(button, accentText)
    if not button or not button:IsA("GuiButton") then return end
    button.AutoButtonColor = false
    local base = button.BackgroundColor3

    trackConnect(button.MouseEnter, function()
        if button:GetAttribute("HoverDisabled") then return end
        TweenService:Create(button, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = THEMES[currentTheme].btnHover
        }):Play()
        if accentText ~= false then
            TweenService:Create(button, TweenInfo.new(0.16), {TextColor3 = ACCENT}):Play()
        end
    end)

    trackConnect(button.MouseLeave, function()
        if button:GetAttribute("HoverDisabled") then return end
        local target = toggleStates and toggleStates[button] and THEMES[currentTheme].btnOn
            or THEMES[currentTheme].btn
        TweenService:Create(button, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = target
        }):Play()
        if accentText ~= false then
            TweenService:Create(button, TweenInfo.new(0.16), {TextColor3 = THEMES[currentTheme].text}):Play()
        end
    end)
end

-- ==================== HELPERS HTTP ====================
local executorRequest = (syn and syn.request) or (http and http.request) or http_request or request

local function decodeApiResponse(raw)
    if type(raw) == "table" then return raw end
    if type(raw) ~= "string" or raw == "" then return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
    return ok and data or nil
end

local function apiGet(endpoint)
    local separator = tostring(endpoint):find("?", 1, true) and "&" or "?"
    local url = API_BASE .. endpoint .. separator .. "_=" .. tostring(os.time())

    if executorRequest then
        local ok, response = pcall(executorRequest, { Url = url, Method = "GET" })
        if ok and response then
            if type(response) == "string" then
                local data = decodeApiResponse(response)
                if data then return data end
            elseif type(response) == "table" then
                local status = tonumber(response.StatusCode or response.Status or response.status_code)
                local rawBody = response.Body or response.body or response.ResponseBody
                if not status or status == 0 or (status >= 200 and status < 300) then
                    local data = decodeApiResponse(rawBody)
                    if data then return data end
                end
            end
        end
    end

    local ok, raw = pcall(function() return game:HttpGet(url) end)
    local data = ok and decodeApiResponse(raw) or nil
    if data then return data end

    -- Alguns ambientes ou proxies bloqueiam query de cache-buster.
    local okPlain, rawPlain = pcall(function() return game:HttpGet(API_BASE .. endpoint) end)
    return okPlain and decodeApiResponse(rawPlain) or nil
end

local function apiPost(endpoint, body)
    local encoded = HttpService:JSONEncode(body or {})
    if executorRequest then
        local ok, response = pcall(executorRequest, {
            Url = API_BASE .. endpoint,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = encoded,
        })
        if ok and response then
            if type(response) == "string" then
                local data = decodeApiResponse(response)
                if data then return data end
            elseif type(response) == "table" then
                local status = tonumber(response.StatusCode or response.Status or response.status_code)
                local rawBody = response.Body or response.body or response.ResponseBody
                if not status or status == 0 or (status >= 200 and status < 300) then
                    local data = decodeApiResponse(rawBody)
                    if data then return data end
                end
            end
        end
    end

    local ok, raw = pcall(function()
        return HttpService:PostAsync(
            API_BASE .. endpoint,
            encoded,
            Enum.HttpContentType.ApplicationJson
        )
    end)
    return ok and decodeApiResponse(raw) or nil
end

local function cleanupPanel()
    if _shuttingDown then return end
    _shuttingDown = true

    for name, callback in pairs(cleanupCallbacks) do
        local ok, err = pcall(callback)
        if not ok then warn("[288] cleanup error [" .. tostring(name) .. "]: " .. tostring(err)) end
        cleanupCallbacks[name] = nil
    end

