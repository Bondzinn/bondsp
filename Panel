    Flashback = GITHUB_RAW .. "/modules/Emphasis/Flashback",
    Impulse = GITHUB_RAW .. "/modules/Emphasis/Impulse",
    Invisible = GITHUB_RAW .. "/modules/Emphasis/Invisible",
