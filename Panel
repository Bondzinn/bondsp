-- ==================== MODERN VISUAL POLISH ====================
local function applyModernPolish()
    for _, obj in ipairs(ScreenGui:GetDescendants()) do
        if obj:IsA("GuiBase2d") then
            obj.AutoLocalize = false
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                local englishText = obj.Text
                if obj.Name ~= "TagText" and englishText ~= ""
                    and englishText:sub(-#ENGLISH_LOCK) ~= ENGLISH_LOCK then
                    obj.Text = englishText .. ENGLISH_LOCK
                end
                if obj:IsA("TextBox") and obj.PlaceholderText ~= ""
                    and obj.PlaceholderText:sub(-#ENGLISH_LOCK) ~= ENGLISH_LOCK then
                    obj.PlaceholderText = obj.PlaceholderText .. ENGLISH_LOCK
                end
            end
        end
        if obj:IsA("TextLabel") then
            if obj.TextColor3 == Color3.fromRGB(200,200,200)
                or obj.TextColor3 == Color3.fromRGB(180,180,180)
                or obj.TextColor3 == Color3.fromRGB(185,185,185) then
                obj.TextColor3 = TEXT_DIM
            end
        elseif obj:IsA("ScrollingFrame") then
            obj.ScrollBarImageColor3 = ACCENT
            obj.ScrollBarThickness = math.min(obj.ScrollBarThickness, 3)
        elseif obj:IsA("TextButton") or obj:IsA("TextBox") then
            local isSmallCircle = obj.Size.X.Offset == obj.Size.Y.Offset and obj.Size.X.Offset <= 40
            local corner = obj:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
            corner.CornerRadius = isSmallCircle and UDim.new(1, 0) or UDim.new(0, 12)
            corner.Parent = obj

            if not obj:FindFirstChildOfClass("UIStroke") then
                local softStroke = Instance.new("UIStroke")
                softStroke.Name = "ModernSoftStroke"
                softStroke.Color = STROKE_SOFT
                softStroke.Transparency = 0.52
                softStroke.Thickness = 1
                softStroke.Parent = obj
            end
        end
    end

    -- Separadores finos e discretos.
    for _, obj in ipairs(Sidebar:GetDescendants()) do
        if obj:IsA("Frame") and obj.Name ~= "ActiveAccent" and obj.Size.Y.Offset == 1 then
            obj.BackgroundColor3 = Color3.fromRGB(39,39,45)
            obj.BackgroundTransparency = 0.2
        end
    end
end
